[[ -n "$ZSH_DEBUGRC" ]] && zmodload zsh/zprof

# Oh-My-Zsh
export ZSH="$HOME/.oh-my-zsh"
export ZSH_CUSTOM="$HOME/.config/zsh"
export ZSH_CACHE_DIR="$HOME/.cache/zsh"
[[ -d "$ZSH_CACHE_DIR" ]] || mkdir -p -- "$ZSH_CACHE_DIR"
export ZSH_COMPDUMP="$ZSH_CACHE_DIR/.zcompdump-${HOST/.*/}-${ZSH_VERSION}"

zstyle ':omz:update' mode disabled

plugins=(
    fzf
    zoxide
    starship
    thefuck

    zhooks
    zsh-autosuggestions
    zsh-completions
    zsh-autopair
    zsh-syntax-highlighting # this has to be the last
)

# Zoxide plugin
ZOXIDE_CMD_OVERRIDE=cd

fpath+=("$({{ .brew_path }} --prefix)/share/zsh/site-functions")
typeset +x FPATH

# PATH: keep the first copy of each entry, so re-prepending an entry moves it instead of duplicating it
typeset -U PATH path

source "$ZSH/oh-my-zsh.sh"

[[ -n "$ZSH_DEBUGRC" ]] && zprof

